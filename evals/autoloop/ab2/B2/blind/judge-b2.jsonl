{"code": "bard2-39-04", "contradiction": 0, "repeats_original": 1, "c_quote": "", "agency": 1, "a_quote": "You pick the middle stepping stones as your ground", "menu": 0, "sheet_readout": 0, "unclear_end": 0, "e_quote": ""}
{"code": "bard2-39-05", "contradiction": 0, "repeats_original": 0, "c_quote": "", "agency": 0, "a_quote": "", "menu": 0, "sheet_readout": 0, "unclear_end": 0, "e_quote": ""}
{"code": "bard2-39-06", "contradiction": 0, "repeats_original": 1, "c_quote": "", "agency": 1, "a_quote": "You pace the stepping stones and pick your spot, a flat shelf of rock mid-stream", "menu": 0, "sheet_readout": 0, "unclear_end": 0, "e_quote": ""}
{"code": "bard2-39-07", "contradiction": 0, "repeats_original": 1, "c_quote": "", "agency": 1, "a_quote": "choose a flat rock midstream", "menu": 0, "sheet_readout": 0, "unclear_end": 0, "e_quote": ""}
