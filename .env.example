# Copy this file to .env (gitignored) and fill in real values before running anything
# in src/ or tests/probe/.

# Required. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model the AI DM uses. Deliberately configurable, not hardcoded (research.md) --
# swapping models should touch this line, not any code. Defaults to a cost-efficient
# model in code if unset; override here to test with a different one.
GAME_DM_MODEL=gemini-3.8-flash
